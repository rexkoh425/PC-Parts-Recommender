    "test:e2e": "playwright test",
    "test:sites:smoke": "playwright test --config playwright.sites.config.ts"
  },
  "dependencies": {
    "next": "16.2.11",
    "postcss": "8.5.21",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.29",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "^5.9.0",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vitest": "^4.0.0",
    "wrangler": "4.113.0"
