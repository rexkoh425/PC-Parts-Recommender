{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "entrypoint": "services.api.main:app",
      "framework": "fastapi",
      "memory": 2048,
      "maxDuration": 60,
      "excludeFiles": [
        "apps/web/**",
        "artifacts/**",
        "data/raw/**",
        "data/processed/**",
        "docs/**",
        "evals/**",
        "node_modules/**",
        "tests/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
