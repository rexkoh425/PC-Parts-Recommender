# Production template. It is intentionally invalid until every CHANGE_ME value is replaced.
# Store each password in a separate, mode-0600 file outside the repository.
COMPOSE_PROJECT_NAME=pcbr-production
PCBR_DEPLOYMENT_ID=CHANGE_ME_UTC_RELEASE_ID
PCBR_PUBLIC_WEB_URL=https://pcbr.example.com
PCBR_PUBLIC_API_URL=https://api.pcbr.example.com

# Release images must be immutable digest references produced by the security/release pipeline.
PCBR_API_IMAGE=ghcr.io/CHANGE_ME/pcbr-api@sha256:CHANGE_ME_DIGEST
PCBR_WEB_IMAGE=ghcr.io/CHANGE_ME/pcbr-web@sha256:CHANGE_ME_DIGEST
PCBR_DAGSTER_IMAGE=ghcr.io/CHANGE_ME/pcbr-dagster@sha256:CHANGE_ME_DIGEST
PCBR_MLFLOW_IMAGE=ghcr.io/CHANGE_ME/pcbr-mlflow@sha256:CHANGE_ME_DIGEST
PCBR_POSTGRES_IMAGE=pgvector/pgvector@sha256:CHANGE_ME_DIGEST
PCBR_POSTGRES_EXPORTER_IMAGE=ghcr.io/CHANGE_ME/pcbr-postgres-exporter@sha256:CHANGE_ME_DIGEST
PCBR_PROMETHEUS_IMAGE=prom/prometheus@sha256:CHANGE_ME_DIGEST
PCBR_BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter@sha256:CHANGE_ME_DIGEST
PCBR_ALPINE_IMAGE=alpine@sha256:CHANGE_ME_DIGEST

# Bind operator endpoints to loopback. Put public traffic through an authenticated TLS ingress.
PCBR_BIND_ADDRESS=127.0.0.1
PCBR_WEB_PORT=3000
PCBR_API_PORT=8000
PCBR_DAGSTER_PORT=3001
PCBR_MLFLOW_PORT=5000
PCBR_PROMETHEUS_PORT=9090

# PostgreSQL bootstrap and least-privilege roles.
PCBR_POSTGRES_ADMIN_USER=pcbr_admin
PCBR_POSTGRES_ADMIN_PASSWORD_FILE=C:/secure/pcbr/postgres-admin.txt
PCBR_DATABASE_NAME=pc_build_recommender
PCBR_MIGRATOR_USER=pcbr_migrator
PCBR_MIGRATOR_PASSWORD_FILE=C:/secure/pcbr/migrator.txt
PCBR_APP_USER=pcbr_app
PCBR_APP_PASSWORD_FILE=C:/secure/pcbr/app.txt
PCBR_DAGSTER_DATABASE=pcbr_dagster
PCBR_DAGSTER_USER=pcbr_dagster
PCBR_DAGSTER_PASSWORD_FILE=C:/secure/pcbr/dagster.txt
PCBR_MLFLOW_DATABASE=pcbr_mlflow
PCBR_MLFLOW_USER=pcbr_mlflow
PCBR_MLFLOW_PASSWORD_FILE=C:/secure/pcbr/mlflow.txt
PCBR_MONITOR_USER=pcbr_monitor
PCBR_MONITOR_PASSWORD_FILE=C:/secure/pcbr/monitor.txt
PCBR_API_ADMIN_TOKEN_FILE=C:/secure/pcbr/admin-token.txt

# Exact, reviewed serving artifacts. Bind mounts are read-only in API containers.
PCBR_BUILDCORES_CATALOG_FILE=C:/pcbr-data/processed/buildcores/records.jsonl
PCBR_GOVERNED_OFFERS_FILE=C:/pcbr-data/processed/governed-offers/records.jsonl
PCBR_REVIEWED_MAPPING_FILE=C:/pcbr-data/release/reviewed-mappings.json
# Review evidence is a rights-checked JSONL artifact. Use an explicit empty file when none is
# licensed for public display; do not omit the release input.
PCBR_REVIEW_EVIDENCE_FILE=C:/pcbr-data/release/review-evidence.jsonl
PCBR_CATALOG_READINESS_ARTIFACT_FILE=C:/pcbr-data/release/catalog-readiness.json
# Contains the pinned manifest plus exact ER model/calibrator, policy, evaluation, and rights files.
PCBR_SERVING_RELEASE_DIR=C:/pcbr-data/release/serving
PCBR_PIPELINE_DATA_DIR=C:/pcbr-data/pipeline
PCBR_PIPELINE_OPERATIONS_DIR=C:/pcbr-data/pipeline-operations
PCBR_PIPELINE_ARTIFACTS_DIR=C:/pcbr-data/artifacts
PCBR_MLFLOW_ARTIFACTS_DIR=C:/pcbr-data/mlflow
PCBR_BACKUP_DIR=C:/pcbr-backups

# API production gates. Never use demo, development, untrained, or wildcard CORS here.
PCBR_API_ENVIRONMENT=production
PCBR_API_SERVICE_MODE=processed_catalog
PCBR_API_DOCS_ENABLED=false
PCBR_API_LOG_LEVEL=INFO
PCBR_API_CORS_ORIGINS=["https://pcbr.example.com"]
PCBR_API_DATA_VERSION=CHANGE_ME_IMMUTABLE_DATA_VERSION
PCBR_API_RANKING_MODEL_VERSION=CHANGE_ME_VERIFIED_RANKER_OR_BASELINE
PCBR_API_COMPATIBILITY_RULE_VERSION=compat_v2
PCBR_API_SOLVER_VERSION=cp_sat_v1
PCBR_API_STALE_AFTER_HOURS=24
PCBR_API_PIPELINE_OPERATIONS_WINDOW_HOURS=168
PCBR_API_SERVING_MANIFEST_PATH=/run/pcbr-serving/serving-manifest.json
PCBR_API_SERVING_MANIFEST_SHA256=CHANGE_ME_SERVING_MANIFEST_SHA256
# Store the validated model at PCBR_SERVING_RELEASE_DIR/encoders/<this SHA-256>.
PCBR_API_SEMANTIC_ENCODER_BUNDLE_SHA256=CHANGE_ME_SEMANTIC_ENCODER_BUNDLE_SHA256
PCBR_API_MAX_REQUEST_BODY_BYTES=1048576
PCBR_API_BUILD_GENERATION_MAX_CONCURRENCY=1
PCBR_API_BUILD_GENERATION_MAX_QUEUE_SIZE=8
PCBR_API_BUILD_GENERATION_QUEUE_TIMEOUT_SECONDS=2
# Public snapshots are immutable, expire after this interval, and require a stored revoke token.
PCBR_API_BUILD_SHARE_TTL_HOURS=720
# Restricted operations surface. The token must live in the mounted secret file, never in this
# env file or any NEXT_PUBLIC_ browser variable.

# Conservative single-host limits. Tune only from measured saturation and latency evidence.
PCBR_POSTGRES_MEMORY=4g
PCBR_POSTGRES_CPUS=2.0
PCBR_API_MEMORY=3g
PCBR_API_CPUS=2.0
PCBR_CATALOG_RELEASE_MEMORY=2g
PCBR_CATALOG_RELEASE_CPUS=1.0
PCBR_WEB_MEMORY=1g
PCBR_WEB_CPUS=1.0
PCBR_DAGSTER_CODE_MEMORY=4g
PCBR_DAGSTER_CONTROL_MEMORY=1g
PCBR_DAGSTER_CPUS=2.0
PCBR_MLFLOW_MEMORY=2g
PCBR_MLFLOW_CPUS=1.0
PCBR_OBSERVABILITY_MEMORY=1g
PCBR_DAGSTER_MAX_CONCURRENT_RUNS=1
PCBR_POSTGRES_MAX_CONNECTIONS=100
PCBR_POSTGRES_SHARED_BUFFERS=1GB
PCBR_POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
PCBR_POSTGRES_SLOW_QUERY_MS=500
PCBR_LOG_MAX_SIZE=20m
PCBR_LOG_MAX_FILES=5
