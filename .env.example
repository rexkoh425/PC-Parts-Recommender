# Local development only. Replace all credentials before any shared deployment.
POSTGRES_DB=pc_build_recommender
POSTGRES_USER=pcbr
POSTGRES_PASSWORD=pcbr_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pcbr:pcbr_local_only@postgres:5432/pc_build_recommender

API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
PCBR_API_ENVIRONMENT=development
PCBR_API_SERVICE_MODE=demo
# Real, provenance-backed mode (use absolute paths on Windows):
# PCBR_API_SERVICE_MODE=processed_catalog
# PCBR_API_BUILDCORES_CATALOG_PATH=C:/path/to/portfolio-3000/records.jsonl
# PCBR_API_DYNACORE_OFFERS_PATH=C:/path/to/dynacore/records.jsonl
# Optional: only an explicitly reviewed manifest may override conservative exact matches.
# PCBR_API_REVIEWED_MAPPING_PATH=C:/path/to/reviewed-mappings.json
PCBR_API_LOG_LEVEL=INFO
PCBR_API_CORS_ORIGINS=["http://localhost:3000"]
PCBR_API_MAX_REQUEST_BODY_BYTES=1048576
# Shared per-process admission pool for build generation and component replacement.
PCBR_API_BUILD_GENERATION_MAX_CONCURRENCY=1
PCBR_API_BUILD_GENERATION_MAX_QUEUE_SIZE=8
PCBR_API_BUILD_GENERATION_QUEUE_TIMEOUT_SECONDS=2
# Server-backed public share links expire after this interval and can be revoked with their token.
PCBR_API_BUILD_SHARE_TTL_HOURS=720
# Ranked results receive short-lived opaque impression tokens. Development uses an ephemeral
# process-local key by default; set this only when tokens must survive a local API restart.
PCBR_API_IMPRESSION_TTL_MINUTES=120
# PCBR_API_IMPRESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Optional restricted operations surface. Inject this from a local secret manager; never use
# NEXT_PUBLIC_ variables or commit a real token. Without it, /v1/admin/operations returns 404.
# PCBR_API_ADMIN_TOKEN=replace-with-a-random-operator-token

DATA_VERSION=development
RANKING_MODEL_VERSION=untrained
COMPATIBILITY_RULE_VERSION=compat_v1
SOLVER_VERSION=cp_sat_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PCBR_API_DATA_VERSION=development
PCBR_API_RANKING_MODEL_VERSION=untrained
PCBR_API_COMPATIBILITY_RULE_VERSION=compat_v1
PCBR_API_SOLVER_VERSION=cp_sat_v1

DAGSTER_PORT=3001
DAGSTER_HOME=/app/.dagster
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_CONTAINER_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://pcbr:pcbr_local_only@postgres:5432/pc_build_recommender
MLFLOW_ARTIFACT_ROOT=/mlartifacts
